        "flowType": "basic",
        "requirement": "ALTERNATIVE",
        "priority": 20,
        "children": [
          {
            "nodeId": "sample-username-password",
            "type": "execution",
            "displayName": "Username Password Form",
            "providerId": "auth-username-password-form",
            "requirement": "REQUIRED",
            "priority": 10,
            "config": {},
            "position": {
              "x": 270,
              "y": 80
            }
          }
        ],
        "position": {
          "x": 80,
          "y": 230
        }
      }
    ]
