        "requirement": "ALTERNATIVE",
        "priority": 10,
        "config": {},
        "position": {
          "x": 80,
          "y": 80
        }
      },
      {
        "nodeId": "sample-forms",
        "type": "subflow",
        "displayName": "Forms",
        "alias": "forms-custom-example",
