{
  "schemaVersion": "1.0",
  "project": {
    "id": "sample-browser-flow",
    "name": "Exemple — Browser Flow personnalisé",
    "description": "Exemple pédagogique à adapter aux providers réellement installés."
  },
  "target": {},
  "flow": {
    "alias": "browser-custom-example",
